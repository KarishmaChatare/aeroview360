# EmailJS Configuration
# 1. Create a free account at https://www.emailjs.com/
# 2. Add an Email Service (e.g., Gmail) and copy the Service ID (e.g. service_xxxxxxx)
# 3. Create an Email Template with variables:
#    {{from_name}}, {{from_email}}, {{phone_number}}, {{service_type}}, {{message}}, {{submission_date}}
#    and copy the Template ID (e.g. template_xxxxxxx)
# 4. Go to Account > API Keys and copy the Public Key (e.g. user_xxxxxxx or xxxxxxxxxxxx)

VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
